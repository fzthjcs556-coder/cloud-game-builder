{
  "name": "cloud-game-builder",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/client",
    "build": "npm run build --workspace apps/client",
    "backend:dev": "npm run start:dev --workspace apps/server",
    "db:up": "docker compose up -d postgres",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
